<Window x:Class="Big2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big 2"
        Icon="Assets/big2.ico"
        Width="900" Height="760"
        Background="#005A28"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- The menu keeps Windows 11's own appearance, deliberately. Restyling a
         WPF MenuItem means supplying ControlTemplates for all four roles, and
         the payoff would be a menu that matches nothing in particular. -->
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" x:Name="TheMenu">
            <MenuItem Header="_Game">
                <MenuItem x:Name="MenuNewHand"   Header="New _Hand"   InputGestureText="F2" />
                <MenuItem x:Name="MenuNewSeries" Header="New _Series" />
                <Separator />
                <MenuItem x:Name="MenuSort"      Header="S_ort Hand"  InputGestureText="F6" />
                <Separator />
                <MenuItem x:Name="MenuOptions"   Header="_Options..." InputGestureText="F5" />
                <Separator />
                <MenuItem x:Name="MenuExit"      Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="MenuAbout"     Header="_About Big 2" />
            </MenuItem>
        </Menu>

        <ContentControl x:Name="TableHost" />
    </DockPanel>
</Window>
