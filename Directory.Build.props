<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols go INSIDE the assembly. The SDK emits portable .pdb files even
         in Release, so without this a publish leaves symbol files beside the
         exe and the output is not one file. Set here rather than per-project so
         a referenced library is covered too. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
